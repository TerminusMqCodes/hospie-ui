# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api

# WebSocket/Pusher Configuration
VITE_PUSHER_APP_KEY=local-app-key
VITE_PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_HOST=localhost
VITE_PUSHER_PORT=6001
VITE_PUSHER_SCHEME=http

# App Configuration
VITE_APP_NAME="Hospie PMS"
VITE_APP_VERSION=1.0.0

# Development Configuration
VITE_DEV_MODE=true

# Firebase Configuration (Optional - for push notifications)
# Get these from Firebase Console: https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=hospie-pms.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hospie-pms
VITE_FIREBASE_STORAGE_BUCKET=hospie-pms.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_VAPID_KEY=YOUR_VAPID_KEY_HERE